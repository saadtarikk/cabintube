# Google Cloud OAuth client type: TVs and Limited Input devices.
# Enable YouTube Data API v3; add your Google account as a consent-screen test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YTDLP_BIN=yt-dlp
PORT=4318
HOST=127.0.0.1
# Must match the browser's origin exactly. Production requires HTTPS.
APP_ORIGIN=http://127.0.0.1:4317
# Deployment only: encrypted persistent sessions and personal access gate.
# SESSION_KEY: random 32 bytes encoded as base64; keep the same key across restarts.
# SESSION_FILE=/data/sessions.enc
# SESSION_KEY=
# ACCESS_CODE_HASH= (SHA-256 hex digest of your personal access code)
